
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/shunt-guard.sh",
            "description": "Deny large whole-file reads; delegate them to a subagent"
          }
        ]
      }
    ]
  }
}
