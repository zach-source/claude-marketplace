{
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "timeout": 30,
          "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/smart-lint.sh",
          "description": "Auto-detect project type and lint the edited file"
        }
      ]
    }
  ]
}
